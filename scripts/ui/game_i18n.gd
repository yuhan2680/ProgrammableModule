static var _translations: Array[Translation] = []
static var _installed: bool = false
static var _error_templates: Array[Dictionary] = []
static var _error_templates_ready := false
static var _error_location: RegEx


## 先逐条翻译再合并错误，避免多行结果被当成一个不存在的翻译键。
static func translate_errors(errors: PackedStringArray) -> String:
	var translated := PackedStringArray()
	for error in errors:
		translated.append(_translate_error_line(error))
	return "\n".join(translated)


## 只启用原生菜单的翻译，避免继承程序编辑区的禁翻译设置。
## 编辑器仍保留玩家源代码原文；方向和控制字符子菜单从主菜单继承翻译模式。
static func localize_text_edit_menu(editor: TextEdit) -> void:
	editor.get_menu().auto_translate_mode = Node.AUTO_TRANSLATE_MODE_ALWAYS


## 注册三种界面语言；简体使用恒等映射，香港繁体只读取内置静态词典。
static func install() -> void:
	if _installed:
		return
	if _translations.is_empty():
		var english := Translation.new()
		english.locale = "en"
		var chinese := Translation.new()
		chinese.locale = "zh_CN"
		var hong_kong := Translation.new()
		hong_kong.locale = "zh_HK"
		for source: String in ENGLISH:
			english.add_message(source, ENGLISH[source])
			chinese.add_message(source, source)
			hong_kong.add_message(source, GameI18nHK.MESSAGES.get(source, source))
		for source: String in NATIVE_MENU_CHINESE:
			# 英文也显式保留源串，切换语言时不依赖操作系统的语言或回退设置。
			english.add_message(source, source)
			chinese.add_message(source, NATIVE_MENU_CHINESE[source])
			hong_kong.add_message(source, GameI18nHK.NATIVE_MENU.get(source, NATIVE_MENU_CHINESE[source]))
		_translations = [english, chinese, hong_kong]
	for translation in _translations:
		# 相同 locale 可以有多个翻译包，不能用其它包的存在替代本项目资源。
		TranslationServer.add_translation(translation)
	_installed = true


## 错误保留源码行列和玩家标识符，只翻译已知诊断模板；超长或未知内容保持原文。
static func _translate_error_line(source: String) -> String:
	var exact := str(TranslationServer.translate(source))
	if exact != source or TranslationServer.get_locale() == "zh_CN" or source.length() > 8192:
		return exact
	if _error_location == null:
		_error_location = RegEx.new()
		_error_location.compile("^第 ([0-9]+) 行，第 ([0-9]+) 列：(.*)$")
	var located := _error_location.search(source)
	if located != null:
		var location_format := str(TranslationServer.translate("第 %s 行，第 %s 列：%s"))
		return location_format % [located.get_string(1), located.get_string(2), _translate_error_detail(located.get_string(3))]
	return _translate_error_detail(source)


## 只编译内置词典中带整数或字符串占位的有限模板，匹配值直接回填，不二次解释玩家文本。
static func _translate_error_detail(source: String) -> String:
	var exact := str(TranslationServer.translate(source))
	if exact != source:
		return exact
	_prepare_error_templates()
	for entry: Dictionary in _error_templates:
		var pattern: RegEx = entry.pattern
		var matched := pattern.search(source)
		if matched != null:
			# 缓存只保留源模板，切换语言后每次读取当前译文；捕获的玩家文本不参与翻译。
			var template := str(TranslationServer.translate(entry.source))
			return _fill_error_template(template, matched)
	return source


## 模板数量受静态词典限制，仅接受 %s 与 %d；其它格式仍由原有精确翻译处理。
static func _prepare_error_templates() -> void:
	if _error_templates_ready:
		return
	_error_templates_ready = true
	for source: String in ENGLISH:
		if not source.contains("%s") and not source.contains("%d"):
			continue
		var pattern_text := "^"
		var index := 0
		var valid := true
		var placeholders := 0
		while index < source.length():
			var character := source[index]
			if character == "%":
				if index + 1 >= source.length() or source[index + 1] not in ["s", "d"]:
					valid = false
					break
				pattern_text += "(.+?)" if source[index + 1] == "s" else "([0-9]+)"
				placeholders += 1
				index += 2
				continue
			if character in "\\.^$|?*+()[]{}":
				pattern_text += "\\"
			pattern_text += character
			index += 1
		var translated: String = ENGLISH[source]
		if not valid or placeholders > 4 or translated.count("%s") + translated.count("%d") != placeholders:
			continue
		var pattern := RegEx.new()
		if pattern.compile(pattern_text + "$") == OK:
			_error_templates.append({"pattern": pattern, "source": source})


## 单次从左到右填入捕获值，名字中的百分号或其它字符不会再被当作格式指令。
static func _fill_error_template(template: String, matched: RegExMatch) -> String:
	var result := ""
	var index := 0
	var group := 1
	while index < template.length():
		if template[index] == "%" and index + 1 < template.length() and template[index + 1] in ["s", "d"]:
			result += matched.get_string(group)
			group += 1
			index += 2
		else:
			result += template[index]
			index += 1
	return result
